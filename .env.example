NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# server-only, never shipped to the client (used by admin scripts / cron only)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_PROJECT_ID=xxxxxxxxxxxx
# Showmore order-sync fallback (browser-scraping, not the real API — see
# src/app/api/internal/showmore-daily-sync/route.ts for why). Generated by Claude.
SHOWMORE_SYNC_SECRET=
# Notifications fan-out cron (src/app/api/cron/notifications-fanout/route.ts), added
# 2026-10-01. Generate your own random value (e.g. `openssl rand -hex 32`) and set it
# BOTH here (local testing) and as an Environment Variable in Vercel → Settings →
# Environment Variables. Vercel automatically sends it as `Authorization: Bearer
# <value>` on every cron-triggered request once `vercel.json` has a schedule for this
# route — nothing else needs to read or forward this value.
CRON_SECRET=
